# Server env template
PORT=4000
NODE_ENV=development

# Firebase admin
# Provide either FIREBASE_SERVICE_ACCOUNT_PATH (absolute path to service account JSON)
# or FIREBASE_SERVICE_ACCOUNT (the JSON string, no newlines).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Payment
USE_MOCK_PAYMENT=true
STRIPE_SECRET_KEY=
