# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Firebase (client SDK) - optional in dev
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin - provide one of the following approaches
# 1) Full JSON string (recommended for CI/CD secure vars)
FIREBASE_SERVICE_ACCOUNT_JSON=

# 2) Path to local JSON file (for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# 3) Split env approach
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PROJECT_ID=

# Payment
USE_MOCK_PAYMENT=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
