PORT=5000
NODE_ENV=production
# Option A: path to service account JSON file (preferred during development)
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\hsgpi\OneDrive\Desktop\parksense-347f2-firebase-adminsdk-fbsvc-d41d1be9c7.json


# Option B: base64 encoded JSON for CI/hosting (decode in firebaseAdmin.js)
# FIREBASE_SERVICE_ACCOUNT=<base64-of-json>


# Firestore database URL (optional, usually admin SDK auto-detects from service account)
#FIRESTORE_EMULATOR_HOST=


# Cors origins allowed by this backend (comma separated) - add your frontend origin
CORS_ORIGIN=http://localhost:3000


# Rate limit settings
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100